{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem",
  "type": "object",
  "properties": {
    "ProblemCategory": {
      "type": "string"
    },
    "ProblemYear": {
      "type": "string"
    },
    "ProblemTitle": {
      "type": "string"
    },
    "ProblemNumber": {
      "type": "string"
    },
    "ProblemText": {
      "type": "string"
    },
    "ProblemAnswer": {
      "type": "string"
    },
    "ProblemTags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "IsStaging": {
      "type": "boolean"
    },
    "SolutionText": {
      "type": "string"
    },
    "AnswerOptions": {
      "type": "string"
    },
    "Action": {
      "type": "integer"
    }
  },
  "required": [
    "ProblemCategory",
    "ProblemYear",
    "ProblemTitle",
    "ProblemNumber",
    "ProblemText",
    "IsStaging",
    "AnswerOptions",
    "Action"
  ],
  "additionalProperties": false
}